[Unit]
Description=Kugou check-in failure alert
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=kgm-checkin
Group=kgm-checkin
WorkingDirectory=/opt/kgm-checkin
EnvironmentFile=/etc/kgm-checkin/checkin.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node scripts/notify-failure.js
TimeoutStartSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077
